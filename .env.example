
# Twitch
TWITCH_USERNAME=your_bot_account
TWITCH_CLIENT_ID=your_twitch_app_client_id
TWITCH_CLIENT_SECRET=your_twitch_app_secret
JOIN_CHANNELS=channel1,channel2
# Optional shared app/Render secret for the private encoder control bridge and
# scoped, privacy-safe connection diagnostics. Generate a random 32+ char token.
ENCODER_BRIDGE_TOKEN=

# SweatyOBS standalone control API (separate Render service; not SweatyClanker).
# Use independent random 32+ character values; never put platform stream keys here.
ENCODER_ADMIN_KEY=
ENCODER_REMOTE_HOST_TOKEN=
# Android service origin is configured at APK build time:
# cd sweatyobs && gradle assembleDebug -PencoderServiceUrl=https://sweatyobs-control-api.onrender.com

# AI providers: configure both to enable automatic failover between them.
# DeepSeek is preferred by default; OpenAI is used when DeepSeek is unavailable.
DEEPSEEK_API_KEY=your_deepseek_api_key
DEEPSEEK_MODEL=deepseek-chat
OPENAI_API_KEY=your_openai_api_key
OPENAI_MODEL=gpt-4.1-mini
AI_PROVIDER_ORDER=deepseek,openai
# After a provider fails, wait this long before probing it for recovery.
AI_FAILBACK_INTERVAL_MS=60000
# Repeated provider failures back off exponentially up to this cap.
AI_MAX_FAILBACK_INTERVAL_MS=300000
AI_HISTORY_LENGTH=5
AI_TEMPERATURE=0.7
AI_MAX_TOKENS=1024
AI_TIMEOUT_MS=10000
AI_MAX_RETRIES=3
AI_CIRCUIT_BREAKER_THRESHOLD=5

# Redis
REDIS_URL=redis://...
WORKERS_ENABLED=false
# auto starts only workers needed by enabled delivery features
WORKER_QUEUES=auto
BULLMQ_DRAIN_DELAY_SECONDS=120
BULLMQ_STALLED_INTERVAL_SECONDS=300
# Core chat can run on local fallbacks when Redis is unavailable
REDIS_REQUIRED=false

# Cooldowns (seconds)
COOLDOWN_DURATION=1
USER_COOLDOWN=5

# Moderation
MAX_REPEAT_MESSAGES=3
MAX_CAPS_RATIO=0.7
ALLOW_LINKS=false

# Emotes
ENABLE_EMOTE_APPENDING=true
EMOTE_APPEND_EXCLUDE_PREFIXES=!,
ENABLE_7TV_EMOTES=true
ENABLE_BTTV_EMOTES=true
ENABLE_FFZ_EMOTES=false

# Auto‑messages
AUTO_MESSAGE_ENABLED=true
AUTO_USE_DEEPSEEK=true
AUTO_WELCOME=true

# Adaptive quiet-chat model
AUTO_CHAT_TICK_SECONDS=30
AUTO_CHAT_MIN_QUIET_SECONDS=90
AUTO_CHAT_MAX_QUIET_SECONDS=360
AUTO_CHAT_BOT_GAP_SECONDS=120
AUTO_CHAT_RECENT_BOT_WINDOW_SECONDS=600
AUTO_CHAT_REQUIRE_LIVE=true

# Automatic analytical comments during strong chat-reaction moments
ANALYTICAL_AUTO_COMMENT_ENABLED=true
ANALYTICAL_MOMENT_COOLDOWN_SECONDS=90

# Legacy fixed-timer values retained for compatibility; adaptive chat uses the settings above.
AUTO_MESSAGE_INTERVAL=300
AUTO_QUIET_THRESHOLD=600

# Media Generation (Pollinations)
IMAGE_COMMAND_NAME=!image
VIDEO_COMMAND_NAME=!video
TTS_COMMAND_NAME=!tts
MUSIC_COMMAND_NAME=!song

# Server
PORT=3000
LOG_LEVEL=info
IGNORED_USERNAMES=
ALLOWED_ORIGINS=https://yourdomain.com
PUBLIC_URL=https://your-app.onrender.com

# EventSub
EVENTSUB_SECRET=your_event_sub_secret
EVENTSUB_WSS_URL=wss://eventsub.wss.twitch.tv/ws

# AI-assisted Twitch VOD highlight detection
HIGHLIGHT_DETECTION_ENABLED=true
HIGHLIGHT_WINDOW_SECONDS=20
HIGHLIGHT_MIN_MESSAGES=3
HIGHLIGHT_COOLDOWN_SECONDS=150
HIGHLIGHT_MAX_CLIPS=5
HIGHLIGHT_AUTO_SCORE_THRESHOLD=64
HIGHLIGHT_AI_FALLBACK_SCORE=84
MANUAL_CLIP_SECONDS=35
MANUAL_CLIP_COOLDOWN_SECONDS=45
VIEWER_CLIP_VOTE_WINDOW_SECONDS=12
VIEWER_CLIP_VOTES_REQUIRED=2

# Protects admin mutation/media/metrics endpoints
ADMIN_API_KEY=

# YouTube upload OAuth
YOUTUBE_UPLOAD_ENABLED=false
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_DEFAULT_PRIVACY=private
YOUTUBE_ALLOW_PUBLIC=false

# TikTok draft upload (requires approved video.upload scope)
TIKTOK_UPLOAD_ENABLED=false
TIKTOK_ACCESS_TOKEN=

# Discord highlight announcements
DISCORD_ANNOUNCE_ENABLED=false
DISCORD_WEBHOOK_URL=

# Twitch conversation pacing
PROACTIVE_WELCOME_MAX_PER_MINUTE=3
WELCOME_ON_JOIN=true
JOIN_WELCOME_BATCH_MS=100
JOIN_WELCOME_DEDUPE_MINUTES=360
TWITCH_MIN_SEND_INTERVAL_MS=1100
TWITCH_GLOBAL_MESSAGES_PER_30S=20

# Advanced commerce strategy
SALES_ENGINE_ENABLED=true
SALES_VIEWER_COOLDOWN_DAYS=30
SALES_CHANNEL_COOLDOWN_MINUTES=15
SALES_CONVERSION_COOLDOWN_DAYS=30
# Optional JSON array of self/affiliate/sponsor offers. Affiliate/sponsor offers require inline disclosure.
SALES_OFFERS_JSON=
# Set true only when Twitch's Branded Content disclosure tool is active for sponsored promotion.
BRANDED_CONTENT_DISCLOSURE_CONFIRMED=false

# Conversational retention learning
RETENTION_ENGINE_ENABLED=true
RETENTION_MIN_SCORE=0.56
RETENTION_MIN_PROMPT_GAP_SECONDS=45
RETENTION_REPLY_WINDOW_SECONDS=120

# Low-pressure silent-user activation
# Twitch Users in Chat are not equivalent to confirmed video viewers.
LURKER_ACTIVATION_ENABLED=true
LURKER_MIN_SILENT_SECONDS=180
LURKER_PROMPT_GAP_SECONDS=240
LURKER_REPLY_WINDOW_SECONDS=120
LURKER_MIN_OPPORTUNITY=0.42
LURKER_TRACKING_WARMUP_SECONDS=90

# Durable Twitch OAuth vault.
# Recommended on Render Free: use a persistent external Postgres URL (for example Neon).
# The token row is AES-256-GCM encrypted with a key derived from TWITCH_CLIENT_SECRET.
TWITCH_TOKEN_DATABASE_URL=

# Reliable join welcome fallback. IRC remains primary; Get Chatters repairs missed JOINs.
CHATTER_WATCH_POLL_SECONDS=30
CHATTER_REJOIN_SUPPRESS_MINUTES=30
